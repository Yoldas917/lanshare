    <!-- Help -->
    <string name="help_card_title">How to use?</string>
    <string name="help_card_desc">Step-by-step guide</string>
    <string name="help_title">How to use</string>
    <string name="help_step1">Install and open this app on both devices.</string>
    <string name="help_step2">Tap \"Pair / Be visible\" on both devices.</string>
    <string name="help_step3">Wait a moment; the other device will appear under \"Nearby devices\".</string>
    <string name="help_step4">On the device card, tap \"Share my screen\". (To watch that device instead, choose \"Watch this device\".)</string>
    <string name="help_step5">Approve the screen sharing permission.</string>
    <string name="help_step6">Sharing starts; your screen appears on the other device.</string>
    <string name="help_step7">To finish, tap \"Disconnect\".</string>
    <string name="help_tips_title">Tips</string>
    <string name="help_tip1">Both devices must be on the same Wi-Fi network.</string>
    <string name="help_tip2">To send audio too, turn on \"Share audio too\" before sharing.</string>
    <string name="help_tip3">You can choose quality and frame rate in the settings.</string>

