<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAN Ekran Paylasimi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oda ID (roomId)" />

        <EditText
            android:id="@+id/roomIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="demo"
            android:inputType="text"
            android:autofillHints="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Signaling sunucu (IP:PORT)" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="192.168.1.165:8080"
            android:inputType="text"
            android:autofillHints="" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/audioSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:checked="false"
            android:text="Sesi de paylas (cihaz ic sesi)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="12sp"
            android:alpha="0.7"
            android:text="Not: sadece YAYINCI icin. Korumali uygulamalar sesi paylasmayabilir." />

        <Button
            android:id="@+id/publisherButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="YAYINCI (ekranimi paylas)" />

        <Button
            android:id="@+id/viewerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="IZLEYICI (ekrani goster)" />

    </LinearLayout>
</ScrollView>
